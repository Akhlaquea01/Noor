[{"ayah":1,"text":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ"},{"ayah":2,"text":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ"},{"ayah":3,"text":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ"},{"ayah":4,"text":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ"},{"ayah":5,"text":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا"},{"ayah":6,"text":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا"},{"ayah":7,"text":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ"},{"ayah":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب"}]