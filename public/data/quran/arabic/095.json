[{"ayah":1,"text":"وَٱلتِّينِ وَٱلزَّيۡتُونِ"},{"ayah":2,"text":"وَطُورِ سِينِينَ"},{"ayah":3,"text":"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ"},{"ayah":4,"text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ"},{"ayah":5,"text":"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ"},{"ayah":6,"text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ"},{"ayah":7,"text":"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ"},{"ayah":8,"text":"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ"}]