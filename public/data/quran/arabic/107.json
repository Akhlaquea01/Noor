[{"ayah":1,"text":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ"},{"ayah":2,"text":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ"},{"ayah":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ"},{"ayah":4,"text":"فَوَيۡلٞ لِّلۡمُصَلِّينَ"},{"ayah":5,"text":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ"},{"ayah":6,"text":"ٱلَّذِينَ هُمۡ يُرَآءُونَ"},{"ayah":7,"text":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ"}]