[{"ayah":1,"text":"وَٱلضُّحَىٰ"},{"ayah":2,"text":"وَٱلَّيۡلِ إِذَا سَجَىٰ"},{"ayah":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"ayah":4,"text":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ"},{"ayah":5,"text":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ"},{"ayah":6,"text":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ"},{"ayah":7,"text":"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ"},{"ayah":8,"text":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ"},{"ayah":9,"text":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ"},{"ayah":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ"},{"ayah":11,"text":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ"}]